# Server Environment Configuration Template
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mern-ecommerce?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Stripe Payment Gateway (Leave as mock for sandbox testing)
STRIPE_SECRET_KEY=sk_test_mock_sandbox_key
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret

# Nodemailer / SMTP Credentials (e.g. Mailtrap or Gmail)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your_smtp_user
SMTP_PASSWORD=your_smtp_pass
FROM_EMAIL=noreply@bharatkart.com
FROM_NAME=BharatKart Platform

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
